/*
  secrets.h.example — template for include/secrets.h

  COPY THIS FILE to `include/secrets.h` and fill in your own values.

      copy include\secrets.h.example include\secrets.h

  `include/secrets.h` is gitignored. **THIS REPO IS PUBLIC** — never put real
  credentials in this .example file, and never hardcode them into a src/*.cpp.

  Only Phase 3 (HomeSpan / Siri) needs this. Phases 1, 1b, 1c and 1d don't touch
  the network and will build without it.
*/

#pragma once

// Your WiFi network.
//
// MUST be 2.4 GHz. The ESP32 cannot see 5 GHz at all. If your router broadcasts
// one merged SSID across both bands with band-steering, the ESP32 may fail to
// associate in a way that looks like a firmware bug — expose a 2.4 GHz-only SSID
// temporarily, or use a phone hotspot set to 2.4 GHz.
#define WIFI_SSID      "your-2.4GHz-network"
#define WIFI_PASSWORD  "your-wifi-password"

// The 8-digit code you type into Apple Home when pairing. Digits only, no dashes
// — HomeSpan formats it for display itself.
//
// Apple rejects trivial codes (00000000, 12345678, repeated digits, and a few
// other well-known ones). The default below is HomeSpan's own and is fine for a
// bench device on your own network; change it for a permanent install.
#define HOMEKIT_PAIRING_CODE  "46637726"
